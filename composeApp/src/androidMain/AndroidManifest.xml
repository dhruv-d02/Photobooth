<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <!-- Phase 3 (export): only needed on API 26-28 - MediaStore scoped storage (API 29+,
         see AndroidMediaRepo) needs no storage permission at all, per architecture.md's
         "no broad storage permission needed on API 26+" (this repo's minSdk). -->
    <uses-permission
        android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="28" />

    <!--
      No launcher icon is declared yet - the real app name/branding is still undecided
      (architecture.md § Non-functional considerations, App name). Adding a throwaway icon
      now would just need redoing in Phase 5; the system default is fine for Phase 0.
    -->
    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Material.Light.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>