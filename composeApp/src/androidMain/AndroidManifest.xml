<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.CAMERA" />
    <uses-feature android:name="android.hardware.camera.front" android:required="false" />
    <uses-feature android:name="android.hardware.camera.any" android:required="true" />

    <!-- No WRITE_EXTERNAL_STORAGE here, deliberately. It used to be declared with
         maxSdkVersion="28" for the legacy (pre-scoped-storage) export path, but minSdk is now
         29, so that declaration could never apply to any device able to install this app -
         it was dead weight that also made the app look like it wanted broad storage access on
         the store listing. On API 29+ MediaStore scoped storage lets an app create and write
         its own entries in the shared Pictures/ collection with no storage permission at all
         (see AndroidMediaRepo.savePng). If a legacy path is ever reinstated, the permission
         must come back *with* a runtime request, not just a manifest line. -->

    <application
        android:name=".PhotoboothApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <!-- Locked portrait: design/handoff/README.md has no landscape spec for any screen
             (every layout, spacing figure and strip-composition formula assumes a vertical
             phone frame), and CLAUDE.md calls the visual design final and pixel-faithful -
             inventing a landscape layout would be a design decision, not a bug fix. Concrete
             failure this also closes: Capture's bottom bar sizes its thumbnail row from screen
             WIDTH via weight+aspectRatio, so in landscape the row's height roughly doubles while
             the screen's available height more than halves, squeezing the weighted viewfinder
             Box to zero height - the camera preview simply had nowhere to draw.

             This does NOT make CaptureViewModel's rotation-survival work
             (SessionHandoffViewModel, onCameraControllerChanged, startOnce's loud refusal on an
             out-of-range retake) redundant: dark-mode toggles, system font/display-size changes,
             split-screen resize and locale changes all still recreate the Activity without a
             rotation, and would hit the identical stale-controller/lost-session-state bugs those
             fixes address. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait"
            android:theme="@style/Theme.Boothie.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
